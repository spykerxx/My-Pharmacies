<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FeedbackActivity">

    <ImageView
        android:id="@+id/imageViewFeedbackBack2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.04000002"
        app:srcCompat="@drawable/feedbacktextnew" />

    <ImageView
        android:id="@+id/imageViewSupportBack5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageViewSupportBack3"
        app:layout_constraintVertical_bias="0.343"
        app:srcCompat="@drawable/pleaserateourapplication" />

    <ImageView
        android:id="@+id/imageViewSupportBack4"
        android:layout_width="210dp"
        android:layout_height="172dp"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.120000005"
        app:srcCompat="@drawable/feedbackimagenew" />

    <ImageView
        android:id="@+id/imageViewSupportBack3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/feedbackgreenbox" />

    <ImageView
        android:id="@+id/imageViewFeedBackSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageViewSupportBack3"
        app:layout_constraintStart_toStartOf="@+id/imageViewSupportBack3"
        app:layout_constraintTop_toTopOf="@+id/imageViewSupportBack3"
        app:layout_constraintVertical_bias="0.93"
        app:srcCompat="@drawable/btnsave" />

    <ImageView
        android:id="@+id/imageViewFeedbackBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.04000002"
        app:srcCompat="@drawable/arrow" />

    <ImageView
        android:id="@+id/imageViewSupportBack2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageViewSupportBack3"
        app:layout_constraintHorizontal_bias="0.074"
        app:layout_constraintStart_toStartOf="@+id/imageViewSupportBack3"
        app:layout_constraintTop_toTopOf="@+id/imageViewSupportBack3"
        app:layout_constraintVertical_bias="0.51"
        app:srcCompat="@drawable/additional" />

    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageViewSupportBack3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/imageViewSupportBack3"
        app:layout_constraintTop_toTopOf="@+id/imageViewSupportBack3"
        app:layout_constraintVertical_bias="0.42000002" />

    <EditText
        android:id="@+id/editTextTextPersonName2"
        android:layout_width="wrap_content"
        android:layout_height="150dp"
        android:background="@drawable/feedbackwhitebox"
        android:ems="10"
        android:inputType="text"
        android:text=""
        app:layout_constraintBottom_toBottomOf="@+id/imageViewSupportBack3"
        app:layout_constraintEnd_toEndOf="@+id/imageViewSupportBack3"
        app:layout_constraintStart_toStartOf="@+id/imageViewSupportBack3"
        app:layout_constraintTop_toTopOf="@+id/imageViewSupportBack3"
        app:layout_constraintVertical_bias="0.75" />
</androidx.constraintlayout.widget.ConstraintLayout>
